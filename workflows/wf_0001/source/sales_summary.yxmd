            <Field name="AMOUNT_TXT" type="V_String" size="20" source="File: C:\data\sales\orders.yxdb" />
            <Field name="QTY" type="Int32" size="4" source="File: C:\data\sales\orders.yxdb" />
            <Field name="ORDER_DATE" type="Date" size="10" source="File: C:\data\sales\orders.yxdb" />
            <Field name="AMOUNT" type="Double" size="8" source="Formula: ToNumber([AMOUNT_TXT])" />
            <Field name="NET" type="Double" size="8" source="Formula: Round([AMOUNT] * IIF([QTY] &gt;= 10, 0.9, 1), 0.01)" />
            <Field name="SIZE_BAND" type="V_String" size="10" source="Formula: SIZE_BAND" />
          </RecordInfo>
        </MetaInfo>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxFormula" />
