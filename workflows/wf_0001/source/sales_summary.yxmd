    <Node ToolID="4">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Formula.Formula">
        <Position x="378" y="18" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <FormulaFields>
            <FormulaField expression="ToNumber([AMOUNT_TXT])" field="AMOUNT" size="8" type="Double" />
            <FormulaField expression="Round([AMOUNT] * IIF([QTY] &gt;= 10, 0.9, 1), 0.01)" field="NET" size="8" type="Double" />
            <FormulaField expression="IF [AMOUNT] &gt;= 1000 THEN &quot;LARGE&quot; ELSEIF [AMOUNT] &gt;= 100 THEN &quot;MEDIUM&quot; ELSE &quot;SMALL&quot; ENDIF" field="SIZE_BAND" size="10" type="V_String" />
          </FormulaFields>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name />
          <DefaultAnnotationText>AMOUNT, NET, SIZE_BAND</DefaultAnnotationText>
        </Annotation>
        <MetaInfo connection="Output">
          <RecordInfo>
            <Field name="CUSTOMER" type="String" size="10" source="File: C:\data\sales\orders.yxdb" />
